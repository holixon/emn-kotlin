  <emn:types>
    <emn:schemaDefinition id="CourseType" name="Course Type">
      <emn:schema schemaFormat="application/schema+json">{
        "type": "string",
        "enum": ["LIVE", "REMOTE"]
        }
      </emn:schema>
    </emn:schemaDefinition>
    <emn:viewType id="AdminCourseView" name="Admin Course View"/>
    <emn:commandType id="CreateCourse" name="Create course">
      <emn:schema schemaFormat="application/schema+json">{
        "type": "object",
        "required": ["courseId", "name", "courseType"],
        "properties": {
        "courseId": {
        "type": "string",
        "format": "uuid",
        "x-emn-role": "entity-id"
        },
        "name": {
        "type": "string"
        },
        "courseType": {
        "$ref": "CourseType"
        },
        "capacity": {
        "type": "integer"
        },
        "createdAt": {
        "type": "string",
        "format": "date-time"
        }
        }
        }
      </emn:schema>
    </emn:commandType>
    <emn:eventType id="CourseCreated" name="Course created">
      <emn:schema schemaFormat="application/schema+json">{
        "type": "object",
        "required": ["courseId", "name", "courseType"],
        "properties": {
        "courseId": {
        "type": "string",
        "format": "uuid",
        "x-emn-tag-key": "course"
        },
        "name": {
        "type": "string"
        },
        "courseType": {
        "$ref": "CourseType"
        },
        "capacity": {
        "type": "integer"
        },
        "createdAt": {
        "type": "string",
        "format": "date-time"
        }
        }
        }
      </emn:schema>
    </emn:eventType>
    <emn:informationFlowType id="InformationFlowType_1sgw71v" name="InformationFlow" sourceRef="AdminCourseView" targetRef="CreateCourse"/>
    <emn:informationFlowType id="InformationFlowType_0wv7e30" name="InformationFlow" sourceRef="CreateCourse" targetRef="CourseCreated"/>
    <emn:queryType id="CourseOverview" name="Course Overview">
      <emn:extensionElements>
        <emnic:informationCompleteness>
          <emnic:ignoredProperties>
            <emnic:ignoredProperty name="students" comment=""/>
          </emnic:ignoredProperties>
        </emnic:informationCompleteness>
      </emn:extensionElements>
      <emn:schema schemaFormat="application/schema+json">{
        "type": "array",
        "items": {
        "type": "object",
        "required": ["courseId", "name", "courseType"],
        "properties": {
        "courseId": {
        "type": "string",
        "format": "uuid"
        },
        "name": {
        "type": "string"
        },
        "courseType": {
        "$ref": "CourseType"
        },
        "capacity": {
        "type": "integer"
        },
        "createdAt": {
        "type": "string",
        "format": "date-time"
        },
        "students": {
        "type": "integer"
        }
        }
        }
        }
      </emn:schema>
    </emn:queryType>
    <emn:informationFlowType id="InformationFlowType_1c3le5u" name="InformationFlow" sourceRef="CourseOverview" targetRef="AdminCourseView"/>
    <emn:informationFlowType id="InformationFlowType_029kx1b" name="InformationFlow" sourceRef="CourseCreated" targetRef="CourseOverview"/>
