  <emn:specification id="Specification_create_course_success" name="Create course" scenario="As an admin I want to create course" sliceRef="Slice_0toflhc">
    <emn:given id="Specification_18vdxuw_given" stateName="No course exists" />
    <emn:when id="Specification_18vdxuw_when">
      <emn:command id="Command_04yfs5h" typeRef="CommandType_create_course">
        <emn:value>
          {
          "courseId": "course-4711",
          "capacity": 25,
          "name": "Physics I"
          }
        </emn:value>
      </emn:command>
    </emn:when>
    <emn:then id="Specification_18vdxuw_then">
      <emn:event id="Event_0wny2nt" typeRef="EventType_course_created">
        <emn:value>
          {
          "courseId": "course-4711",
          "capacity": 25,
          "name": "Physics I"
          }
        </emn:value>
      </emn:event>
    </emn:then>
  </emn:specification>
  <emn:specification id="Specification_create_course_error" name="Don&#39;t create course" sliceRef="Slice_0toflhc">
    <emn:given id="Specification_1quqjt0_given" stateName="Course exists">
      <emn:event id="Event_1hq514a" typeRef="EventType_course_created">
        <emn:value>
          {
          "courseId": "course-4711",
          "capacity": 25,
          "name": "Physics I"
          }
        </emn:value>
      </emn:event>
    </emn:given>
    <emn:when id="Specification_1quqjt0_when">
      <emn:command id="Command_04gsa49" typeRef="CommandType_create_course">
        <emn:value>
          {
          "courseId": "course-4711",
          "capacity": 25,
          "name": "Physics I"
          }
        </emn:value>
      </emn:command>
    </emn:when>
    <emn:then id="Specification_1quqjt0_then">
      <emn:error id="Error_1h6wufi" typeRef="ErrorType_duplicate_course">
        <emn:value>
          {
          "message": "Course with id=course-4711 already exists."
          }
        </emn:value>
      </emn:error>
    </emn:then>
  </emn:specification>
  <emn:specification id="Specification_1gtvjcl" name="Rename course" scenario="If I rename a course, the course will get a new name" sliceRef="Slice_0xnxibu">
    <emn:given id="Specification_1gtvjcl_given">
      <emn:event id="Event_1oza6ao" typeRef="EventType_course_created">
        <emn:value>
          {
          "courseId": "course-4711",
          "name": "Physics I",
          "capacity": 25
          }
        </emn:value>
      </emn:event>
    </emn:given>
    <emn:when id="Specification_1gtvjcl_when">
      <emn:command id="Command_1tlkgbx" typeRef="CommandType_rename_course">
        <emn:value>
          {
          "courseId": "course-4711",
          "name": "Physics II"
          }
        </emn:value>
      </emn:command>
    </emn:when>
    <emn:then id="Specification_1gtvjcl_then">
      <emn:event id="Event_1tuemla" typeRef="EventType_course_renamed">
        <emn:value>
          {
          "courseId": "course-4711",
          "name": "Physics II"
          }
        </emn:value>
      </emn:event>
    </emn:then>
  </emn:specification>
  <emn:specification id="Specification_1ote18y" name="Rename course to the same name" scenario="If I rename a course and the same name is provided, nothing happens" sliceRef="Slice_0xnxibu">
    <emn:given id="Given_0uun07f">
      <emn:event id="Event_0ge116t" typeRef="EventType_course_created">
        <emn:value>
          {
          "courseId": "course-4711",
          "name": "Physics I",
          "capacity": 25
          }
        </emn:value>
      </emn:event>
    </emn:given>
    <emn:when id="When_0wrpria">
      <emn:command id="Command_04u3bw3" typeRef="CommandType_rename_course">
        <emn:value>
          {
          "courseId": "course-4711",
          "name": "Physics I"
          }
        </emn:value>
      </emn:command>
    </emn:when>
    <emn:then id="Then_1tkg7df" />
  </emn:specification>
  <emn:specification id="Specification_0wjemf5" name="Rename non-existing course" scenario="If I rename a course that does not exists, an error is thrown" sliceRef="Slice_0xnxibu">
    <emn:given id="Given_0z7eshb" />
    <emn:when id="When_0t6n42q">
      <emn:command id="Command_18yqilx" typeRef="CommandType_rename_course">
        <emn:value>
          {
          "courseId": "course-4711",
          "name": "Physics I"
          }
        </emn:value>
      </emn:command>
    </emn:when>
    <emn:then id="Then_1dezz9r">
      <emn:error id="Error_0q2v7fo" typeRef="ErrorType_course_does_not_exist">
        <emn:value>
          {
          "message": "Course with id=course-4711 does not exist."
          }
        </emn:value>
      </emn:error>
    </emn:then>
  </emn:specification>
