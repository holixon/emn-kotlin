<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.holixon.emn._</groupId>
    <artifactId>emn-kotlin-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../../_build/parent/pom.xml</relativePath>
  </parent>

  <groupId>io.holixon.emn.example</groupId>
  <artifactId>university-example-json-schema</artifactId>
  <name>university-example-json-schema</name>
  <description>University Example generating Kotlin classes from embedded JSON Schemas in EMN.</description>

  <dependencies>
    <dependency>
      <groupId>org.axonframework</groupId>
      <artifactId>axon-modelling</artifactId>
      <version>${axon.version}</version>
    </dependency>
    <dependency>
      <groupId>org.axonframework</groupId>
      <artifactId>axon-eventsourcing</artifactId>
      <version>${axon.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-emn-resources</id>
            <phase>initialize</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${kp.generatedResources}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.root.dir}/_emn/</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.holixon.emn.generation</groupId>
        <artifactId>emn-kotlin-axon5-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <id>generate-json-schema-kotlin</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate-schema-kotlin</goal>
            </goals>
            <configuration>
              <resourceDirectory>${kp.generatedResources}</resourceDirectory>
              <includes>json-schema/**.emn</includes>
              <rootPackageName>io.holixon.emn.example.university</rootPackageName>
              <annotationEnhancers>
                <annotationEnhancer>axon5</annotationEnhancer>
              </annotationEnhancers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
