<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.holixon.emn._</groupId>
    <artifactId>emn-kotlin-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../../_build/parent/pom.xml</relativePath>
  </parent>

  <groupId>io.holixon.emn.example</groupId>
  <artifactId>quizmania-example-json-schema</artifactId>
  <name>quizmania-example-json-schema</name>
  <description>Quizmania example generating Kotlin classes from embedded JSON Schemas in EMN.</description>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.module</groupId>
      <artifactId>jackson-module-kotlin</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.axonframework</groupId>
      <artifactId>axon-modelling</artifactId>
      <version>${axon.version}</version>
    </dependency>
    <dependency>
      <groupId>org.axonframework</groupId>
      <artifactId>axon-eventsourcing</artifactId>
      <version>${axon.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-emn-resources</id>
            <phase>initialize</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${kp.generatedResources}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.root.dir}/_emn/</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.holixon.emn</groupId>
        <artifactId>emn-maven-plugin</artifactId>
        <version>${project.version}</version>
        <configuration>
          <resourceDirectory>${project.root.dir}/_emn</resourceDirectory>
          <includes>
            <include>quizmania/**.emn</include>
          </includes>
          <rootPackageName>io.holixon.emn.example.quizmania</rootPackageName>
        </configuration>
        <executions>
          <execution>
            <id>generate-json-schema-kotlin</id>
            <goals>
              <goal>generate-kotlin</goal>
            </goals>
            <configuration>
              <annotationEnhancers>
                <annotationEnhancer>axon5</annotationEnhancer>
                <annotationEnhancer>jackson</annotationEnhancer>
              </annotationEnhancers>
            </configuration>
          </execution>
          <execution>
            <id>export-json-schemas</id>
            <goals>
              <goal>export-schemas</goal>
            </goals>
            <configuration>
              <sourceRoot>${project.root.dir}</sourceRoot>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
